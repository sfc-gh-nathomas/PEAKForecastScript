def fmt_m(val):
    """Format ACV value as $XXM or $XX.XM."""
    m = val / 1_000_000
    if m >= 10:
        return f"${m:.0f}M"
    return f"${m:.1f}M"


def fmt_pct(num, denom):
    if not denom:
        return "—"
    return f"{100*num/denom:.0f}%"


def pct_f(num, denom):
    if not denom:
        return 0
    return 100 * num / denom


