def compute_m1(r):
    """
    M1 Pipeline Risk:
      Commit  = Stage6 + Stage5 (all pass 79d threshold at 91d remaining)
      ML      = Commit + TW_Good (>13d in TW) + PreTW_Good (>55d in Pre-TW)
      Stretch = total pipeline
    """
    commit  = r["STAGE6_ACV"] + r["IMP_TOTAL"]
    ml      = commit + r["TW_GOOD"] + r["PRETW_GOOD"]
    stretch = r["TOTAL_ACV"]
    return {"commit": commit, "ml": ml, "stretch": stretch}


def compute_m3(r):
    """
    M3 Stage Conversion (PEAK QC Dashboard methodology):
      Milestone-date classification, divisor formula, 4Q calibration
      ML = known_ml / (1 - avg_new_pct)
      Commit = known_commit / (1 - min_new_pct)
      Stretch = total pipeline (capped)
    """
    imp_acv   = r.get("IMP_MILESTONE", r["IMP_TOTAL"] + r["STAGE6_ACV"])
    tw_acv    = r.get("TW_MILESTONE", r["TW_TOTAL"])
    pretw_acv = r.get("PRETW_MILESTONE", r["PRETW_TOTAL"])

    known_ml     = (imp_acv * M3_AVG_IMP_RATE) + (tw_acv * M3_AVG_TW_RATE) + (pretw_acv * M3_AVG_PRETW_RATE)
    known_commit = (imp_acv * M3_MIN_IMP_RATE) + (tw_acv * M3_MIN_TW_RATE) + (pretw_acv * M3_MIN_PRETW_RATE)

    ml      = known_ml / (1 - M3_AVG_NEW_PCT)
    commit  = known_commit / (1 - M3_MIN_NEW_PCT)
    stretch = r["TOTAL_ACV"]   # capped at total pipeline
    return {"commit": commit, "ml": ml, "stretch": stretch}


def compute_m4(m1, m3):
    commit  = M4_W1 * m1["commit"]  + M4_W3 * m3["commit"]
    ml      = M4_W1 * m1["ml"]      + M4_W3 * m3["ml"]
    stretch = M4_W1 * m1["stretch"] + M4_W3 * m3["stretch"]
    return {"commit": commit, "ml": ml, "stretch": stretch}


