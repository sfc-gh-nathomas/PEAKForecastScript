def generate_html(regions, targets, yoy_total, districts, wins_data):
    today_str = TODAY.strftime("%B %-d, %Y")
    days_label = (
        f"{abs(DAYS_TO_Q3_OPEN)} days before Q3 opens"
        if DAYS_TO_Q3_OPEN > 0
        else (
            f"Q3 day {-DAYS_TO_Q3_OPEN + 1} of {Q3_DAYS}"
            if DAYS_TO_Q3_OPEN <= 0 else "Q3 opens today"
        )
    )

    # Aggregate totals
    total_pipeline = sum(r["TOTAL_ACV"] for r in regions)
    total_target   = sum(targets.values())

    # Compute models for each region
    region_models = []
    for r in regions:
        m1 = compute_m1(r)
        m3 = compute_m3(r)
        m4 = compute_m4(m1, m3)
        region_models.append((r, m1, m3, m4))

    # Aggregate model totals
    agg_m1 = {k: sum(rm[1][k] for rm in region_models) for k in ("commit","ml","stretch")}
    agg_m3 = {k: sum(rm[2][k] for rm in region_models) for k in ("commit","ml","stretch")}
    agg_m4 = {k: sum(rm[3][k] for rm in region_models) for k in ("commit","ml","stretch")}

    # Progress bar widths (cap at 100%)
    target_ref = total_target
    def bar_w(val): return min(100, 100 * val / target_ref) if target_ref else 0

    m4_ml_pct_str = fmt_pct(agg_m4["ml"], total_target)
    m4_str_pct_str = fmt_pct(agg_m4["stretch"], total_target)
    m4_cmt_pct_str = fmt_pct(agg_m4["commit"], total_target)

    html_parts = [f"""<!DOCTYPE html>
