# PEAK QC Dashboard methodology, calibrated from 4 quarters with Q2 FY27 at 2× weight
# Weights: Q3 FY26=1, Q4 FY26=1, Q1 FY27=1, Q2 FY27=2 (recency-weighted)
# Formula: known_ml / (1 - avg_new_pct), milestone-date classification
M3_AVG_IMP_RATE   = 0.566   # wt avg(49.1, 57.2, 46.3, 65.1×2) / 5
M3_AVG_TW_RATE    = 0.293   # wt avg(20.6, 27.1, 19.4, 39.7×2) / 5
